---
import { Users, CalendarClock, ThumbsUp } from '@lucide/astro';
import { useTranslations } from '../i18n/translations';
import { getImage } from 'astro:assets';
import matricsBg from '../assets/matrics_bg.png';

const locale = Astro.currentLocale === 'en' ? 'en' : (Astro.currentLocale === 'fr' ? 'fr' : 'ar');
const t = useTranslations(locale);

// Optimize background image
const optimizedBg = await getImage({ src: matricsBg, format: 'webp', width: 1024, quality: 50 });
---
<!-- Impact Metrics Section -->
<section class="min-h-[100dvh] flex flex-col justify-center py-20 bg-on-background text-on-primary relative overflow-hidden" id="metrics">
  <!-- Background image -->
  <div class="absolute inset-0 z-0 opacity-15 bg-cover bg-center bg-no-repeat pointer-events-none" style={`background-image: url('${optimizedBg.src}');`}></div>
  <div class="absolute inset-0 z-0 opacity-20 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-primary via-on-background to-on-background"></div>
  <div class="container mx-auto max-w-container-max px-gutter relative z-10 w-full">
    <div class="text-center mb-16 max-w-3xl mx-auto reveal">
      <h2 class="font-headline-lg text-3xl md:text-headline-lg mb-4">{t('metrics.title')}</h2>
      <div class="w-24 h-1 bg-primary mx-auto mb-8 rounded-full"></div>
      <p class="font-body-lg text-body-lg text-surface-variant opacity-90">
        {t('metrics.desc')}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 md:gap-8">
      <!-- Metric 1 -->
      <div class="bg-surface/10 border border-surface/20 p-8 rounded-2xl flex flex-col items-center text-center backdrop-blur-sm group hover:bg-surface/15 hover:border-primary/30 hover:-translate-y-1.5 transition-all duration-300 reveal delay-100">
        <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mb-4 group-hover:bg-primary transition-colors duration-300">
          <Users class="w-6 h-6 text-primary group-hover:text-on-primary transition-colors" />
        </div>
        <div class="font-display-lg text-4xl md:text-5xl text-primary mb-2">{t('metrics.stat1.val')}</div>
        <div class="font-label-bold text-label-bold text-surface-variant">{t('metrics.stat1.label')}</div>
      </div>

      <!-- Metric 2 -->
      <div class="bg-surface/10 border border-surface/20 p-8 rounded-2xl flex flex-col items-center text-center backdrop-blur-sm group hover:bg-surface/15 hover:border-primary/30 hover:-translate-y-1.5 transition-all duration-300 reveal delay-200">
        <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mb-4 group-hover:bg-primary transition-colors duration-300">
          <CalendarClock class="w-6 h-6 text-primary group-hover:text-on-primary transition-colors" />
        </div>
        <div class="font-display-lg text-4xl md:text-5xl text-primary mb-2">{t('metrics.stat2.val')}</div>
        <div class="font-label-bold text-label-bold text-surface-variant">{t('metrics.stat2.label')}</div>
      </div>

      <!-- Metric 3 -->
      <div class="bg-surface/10 border border-surface/20 p-8 rounded-2xl flex flex-col items-center text-center backdrop-blur-sm group hover:bg-surface/15 hover:border-primary/30 hover:-translate-y-1.5 transition-all duration-300 reveal delay-300">
        <div class="w-14 h-14 bg-primary/20 rounded-full flex items-center justify-center mb-4 group-hover:bg-primary transition-colors duration-300">
          <ThumbsUp class="w-6 h-6 text-primary group-hover:text-on-primary transition-colors" />
        </div>
        <div class="font-display-lg text-4xl md:text-5xl text-primary mb-2">{t('metrics.stat3.val')}</div>
        <div class="font-label-bold text-label-bold text-surface-variant">{t('metrics.stat3.label')}</div>
      </div>
    </div>
  </div>
</section>
