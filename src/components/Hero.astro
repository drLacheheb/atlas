---
import { Bolt, ArrowDown } from '@lucide/astro';
import { useTranslations } from '../i18n/translations';
import { getImage } from 'astro:assets';
import heroBg from '../assets/hero_bg.png';

const locale = Astro.currentLocale === 'en' ? 'en' : (Astro.currentLocale === 'fr' ? 'fr' : 'ar');
const t = useTranslations(locale);

const titleSize = locale === 'ar' ? 'text-[clamp(1.875rem,3vw+1.5rem,5rem)]' : 'text-[clamp(1.875rem,2.5vw+1.25rem,3.75rem)]';

// Optimize background image
const optimizedHeroBg = await getImage({ src: heroBg, format: 'webp', width: 1280, quality: 60 });
---
<!-- Hero Section -->
<section class="relative min-h-screen flex items-center py-16 md:py-0 bg-on-background text-on-primary overflow-hidden">
  <div class="absolute inset-0 z-0 opacity-15 bg-cover bg-center bg-no-repeat" style={`background-image: url('${optimizedHeroBg.src}');`}></div>
  <div class="absolute inset-0 z-0 opacity-15 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-primary via-on-background to-on-background"></div>
  <div class="container mx-auto max-w-container-max px-gutter relative z-10 grid md:grid-cols-12 gap-8 md:gap-12 items-center">
    <div class="md:col-span-7 flex flex-col items-center md:items-start text-center md:text-start space-y-6 md:space-y-8 order-2 md:order-1">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-surface/10 rounded-full border border-surface/20 reveal">
        <Bolt class="w-4 h-4 text-primary" />
        <span class="font-label-bold text-label-bold text-surface-variant uppercase tracking-wider">{t('hero.badge')}</span>
      </div>
      <h1 class={`font-display-lg leading-tight ${titleSize} text-center md:text-start reveal delay-100`}>
        {t('hero.title1')}<br>
        <span class="text-primary">{t('hero.title2')}</span>
      </h1>
      <p class="font-body-lg text-body-lg text-surface-variant max-w-2xl opacity-90 text-center md:text-start reveal delay-200">
        {t('hero.desc')}
      </p>
      <div class="flex flex-wrap justify-center md:justify-start gap-4 w-full pt-2 reveal delay-300">
        <a class="inline-flex items-center justify-center bg-primary text-on-primary px-8 py-4 rounded-full font-label-bold text-label-bold hover:-translate-y-0.5 transition-transform" href="#contact">
          {t('hero.cta')}
          <ArrowDown class="w-5 h-5 ms-2" />
        </a>
      </div>
    </div>
    
    <div class="md:col-span-5 relative flex items-center justify-center order-1 md:order-2 reveal-scale delay-200">
      <img alt={t('hero.logoAlt')} class="w-28 h-28 md:w-full md:max-w-none md:h-auto md:max-h-[28rem] object-contain drop-shadow-[0_0_25px_rgba(227,30,36,0.35)]" src="/favicon.svg">
    </div>
  </div>
</section>
