---
import { useTranslations } from '../i18n/translations';

const locale = Astro.currentLocale === 'en' ? 'en' : 'ar';
const t = useTranslations(locale);
const isEn = locale === 'en';
const baseLocalePath = isEn ? '/en' : '';
const homeLink = isEn ? '/en/' : '/';
const servicesLink = `${baseLocalePath}/#services`;
const benefitsLink = `${baseLocalePath}/#benefits`;
const metricsLink = `${baseLocalePath}/#metrics`;
const contactLink = `${baseLocalePath}/#contact`;

const privacyLink = `${baseLocalePath}/privacy`;
const termsLink = `${baseLocalePath}/terms`;
const faqLink = `${baseLocalePath}/faq`;
---
<!-- Footer Section -->
<footer class="text-on-surface bg-on-background/95 border-t border-surface/10 py-10 relative overflow-hidden">
  <div class="container mx-auto max-w-container-max px-gutter relative z-10">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6 pb-8 border-b border-surface/10">
      <div class="flex flex-col md:flex-row items-center gap-4 text-center md:text-start">
        <span class="font-headline-lg text-2xl font-bold text-primary uppercase tracking-wider">Atlas</span>
        <span class="text-surface-variant font-body-md border-s border-surface/20 ps-4 hidden md:inline">{t('footer.desc')}</span>
      </div>
      <p class="text-surface-variant font-body-md md:hidden text-center max-w-sm">{t('footer.desc')}</p>
    </div>

    <!-- Footer Bottom Bar -->
    <div class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm font-label-bold text-label-bold opacity-80 text-surface-variant">
      <div>{t('footer.copyright')}</div>
      <div class="flex flex-wrap justify-center gap-6">
        <a class="hover:text-primary transition-colors" href={privacyLink}>{t('footer.legal.item1')}</a>
        <a class="hover:text-primary transition-colors" href={termsLink}>{t('footer.legal.item2')}</a>
        <a class="hover:text-primary transition-colors" href={faqLink}>{t('footer.legal.item3')}</a>
      </div>
    </div>
  </div>
</footer>
