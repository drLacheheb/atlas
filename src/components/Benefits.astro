---
import { Coins, Timer, ShieldCheck } from '@lucide/astro';
import { useTranslations } from '../i18n/translations';
import { Image, getImage } from 'astro:assets';
import keyBenefitsBg from '../assets/key_benefits_bg.png';
import vision3 from '../assets/vision_3_1_1.png';

const locale = Astro.currentLocale === 'en' ? 'en' : (Astro.currentLocale === 'fr' ? 'fr' : 'ar');
const t = useTranslations(locale);
const dir = locale === 'ar' ? 'rtl' : 'ltr';

// Optimize background image
const optimizedBg = await getImage({ src: keyBenefitsBg, format: 'webp', width: 1024, quality: 50 });
---
<!-- Core Benefits Section -->
<section class="min-h-[100dvh] py-20 flex flex-col justify-center bg-surface relative overflow-hidden bg-grid-pattern" id="benefits">
  <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_center,_var(--color-surface-container-high)_0%,_transparent_75%)] opacity-50 pointer-events-none"></div>
  <div class="absolute inset-0 z-0 opacity-15 bg-cover bg-center bg-no-repeat pointer-events-none" style={`background-image: url('${optimizedBg.src}');`}></div>
  <div class="container mx-auto max-w-container-max px-gutter relative z-10 w-full">
    <div class="grid md:grid-cols-12 gap-8 md:gap-12 items-stretch" dir={dir}>
      <!-- Cards Column (Left on Desktop, Full Width on Mobile) -->
      <div class="col-span-12 md:col-span-7 space-y-4">
        <div class="mb-6 text-center md:text-start reveal">
          <h2 class="font-headline-lg text-3xl md:text-headline-lg mb-4">{t('benefits.title')}</h2>
          <div class="w-24 h-1 bg-primary mx-auto md:mx-0 mb-6 rounded-full"></div>
          <p class="font-body-md text-base text-secondary">
            {t('benefits.desc')}
          </p>
        </div>
        <!-- Benefit 1 -->
        <div class="bg-surface-container-lowest p-4 rounded-2xl border border-surface-container-highest hover:shadow-[0_12px_30px_rgba(186,0,19,0.06)] hover:border-primary/20 hover:-translate-y-1 transition-all duration-300 group flex items-start gap-3 reveal delay-100">
          <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-primary transition-all duration-300 group-hover:scale-110">
            <Coins class="w-5 h-5 text-primary group-hover:text-on-primary transition-colors" />
          </div>
          <div class="flex-grow">
            <h3 class="font-headline-md text-base font-bold mb-1 text-on-background group-hover:text-primary transition-colors">{t('benefits.card1.title')}</h3>
            <p class="font-body-md text-xs text-secondary leading-relaxed">{t('benefits.card1.desc')}</p>
          </div>
        </div>

        <!-- Benefit 2 -->
        <div class="bg-surface-container-lowest p-4 rounded-2xl border border-surface-container-highest hover:shadow-[0_12px_30px_rgba(186,0,19,0.06)] hover:border-primary/20 hover:-translate-y-1 transition-all duration-300 group flex items-start gap-3 reveal delay-200">
          <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-primary transition-all duration-300 group-hover:scale-110">
            <Timer class="w-5 h-5 text-primary group-hover:text-on-primary transition-colors" />
          </div>
          <div class="flex-grow">
            <h3 class="font-headline-md text-base font-bold mb-1 text-on-background group-hover:text-primary transition-colors">{t('benefits.card2.title')}</h3>
            <p class="font-body-md text-xs text-secondary leading-relaxed">{t('benefits.card2.desc')}</p>
          </div>
        </div>

        <!-- Benefit 3 -->
        <div class="bg-surface-container-lowest p-4 rounded-2xl border border-surface-container-highest hover:shadow-[0_12px_30px_rgba(186,0,19,0.06)] hover:border-primary/20 hover:-translate-y-1 transition-all duration-300 group flex items-start gap-3 reveal delay-300">
          <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-primary transition-all duration-300 group-hover:scale-110">
            <ShieldCheck class="w-5 h-5 text-primary group-hover:text-on-primary transition-colors" />
          </div>
          <div class="flex-grow">
            <h3 class="font-headline-md text-base font-bold mb-1 text-on-background group-hover:text-primary transition-colors">{t('benefits.card3.title')}</h3>
            <p class="font-body-md text-xs text-secondary leading-relaxed">{t('benefits.card3.desc')}</p>
          </div>
        </div>
      </div>

      <!-- Image Column (Right on Desktop, Hidden on Mobile) -->
      <div class="hidden md:block md:col-span-5 overflow-hidden rounded-2xl bg-surface-container shadow-lg reveal delay-200 h-full">
        <Image src={vision3} alt={t('benefits.title')} class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" width={600} quality={75} />
      </div>
    </div>
  </div>
</section>
