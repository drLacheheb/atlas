---
import '../styles/global.css';
import { useTranslations } from '../i18n/translations';

interface Props {
	title?: string;
	description?: string;
	robots?: string;
}

const locale = Astro.currentLocale === 'en' ? 'en' : (Astro.currentLocale === 'fr' ? 'fr' : 'ar');
const dir = locale === 'ar' ? 'rtl' : 'ltr';
const t = useTranslations(locale);

const defaultTitle = locale === 'ar'
	? "أطلس للكهرباء - الخبرة الفنية التي تستحقها مشاريعك"
	: (locale === 'fr'
		? "Atlas Électricité - L'Expertise Technique que Vos Projets Méritent"
		: "Atlas Electricity - The Technical Expertise Your Projects Deserve");
const defaultDescription = t('hero.desc');

const { 
	title = defaultTitle,
	description = defaultDescription,
	robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
} = Astro.props;

// Dynamic hreflang link generation for Multilingual SEO
const currentPath = Astro.url.pathname;
let cleanPath = currentPath;
if (cleanPath.startsWith('/en')) {
  cleanPath = cleanPath.substring(3);
} else if (cleanPath.startsWith('/fr')) {
  cleanPath = cleanPath.substring(3);
}
if (!cleanPath.startsWith('/')) {
  cleanPath = '/' + cleanPath;
}

const arUrl = new URL(cleanPath === '/' ? '/' : cleanPath, Astro.url.origin).toString();
const enUrl = new URL(cleanPath === '/' ? '/en/' : `/en${cleanPath}`, Astro.url.origin).toString();
const frUrl = new URL(cleanPath === '/' ? '/fr/' : `/fr${cleanPath}`, Astro.url.origin).toString();

// Structured Schema Markup
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Electrician",
  "name": locale === 'ar' ? "أطلس للكهرباء" : (locale === 'fr' ? "Atlas Électricité" : "Atlas Electricity"),
  "description": description,
  "url": Astro.url.href,
  "logo": new URL('/favicon.svg', Astro.url.href).toString(),
  "image": new URL('/og-image.png', Astro.url.href).toString(),
  "telephone": "+213666921513",
  "email": "achraf.berrah.dz@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "DZ",
    "addressRegion": "Algiers"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "36.7528",
    "longitude": "3.0420"
  },
  "priceRange": "$$",
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
    ],
    "opens": "00:00",
    "closes": "23:59"
  },
  "sameAs": [
    "https://linktr.ee/achraf_berrah"
  ],
  "areaServed": [
    {
      "@type": "AdministrativeArea",
      "name": "Algiers"
    },
    {
      "@type": "Country",
      "name": "Algeria"
    }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": locale === 'ar' ? "الخدمات الكهربائية الفنية" : (locale === 'fr' ? "Services Techniques Électriques" : "Technical Electrical Services"),
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": locale === 'ar' ? "تركيبات كهربائية معمارية" : (locale === 'fr' ? "Installations Électriques Architecturales" : "Architectural Electrical Installations"),
          "description": t('services.card1.desc')
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": locale === 'ar' ? "إصلاح وصيانة الأعطال" : (locale === 'fr' ? "Dépannage et Réparation Électrique" : "Electrical Troubleshooting & Repairs"),
          "description": t('services.card2.desc')
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": locale === 'ar' ? "استشارات وحلول فنية" : (locale === 'fr' ? "Consultations et Solutions Techniques" : "Technical Consultations & Solutions"),
          "description": t('services.card3.desc')
        }
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "124",
    "bestRating": "5",
    "worstRating": "3"
  }
};

// WebSite Schema for Google Site Name representation
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": locale === 'ar' ? "أطلس للكهرباء" : (locale === 'fr' ? "Atlas Électricité" : "Atlas Electricity"),
  "alternateName": ["أطلس", "Atlas", "Atlas Electricity", "Atlas Électricité"],
  "url": "https://atlas-electricity.vercel.app/"
};

// Organization Schema for Google Knowledge Graph
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": locale === 'ar' ? "أطلس للكهرباء" : (locale === 'fr' ? "Atlas Électricité" : "Atlas Electricity"),
  "url": "https://atlas-electricity.vercel.app/",
  "logo": new URL('/favicon.svg', Astro.url.origin).toString(),
  "email": "achraf.berrah.dz@gmail.com",
  "telephone": "+213666921513",
  "sameAs": [
    "https://linktr.ee/achraf_berrah"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+213666921513",
    "contactType": "technical support",
    "areaServed": "DZ",
    "availableLanguage": ["Arabic", "English", "French"]
  }
};

// BreadcrumbList Structured Data for Google search breadcrumbs
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": locale === 'ar' ? "الرئيسية" : (locale === 'fr' ? "Accueil" : "Home"),
    "item": new URL(locale === 'ar' ? '/' : `/${locale}/`, Astro.url.origin).toString()
  }
];

if (cleanPath !== '/') {
  let pageTitle = cleanPath.replace(/^\/|\/$/g, ''); // strip leading/trailing slashes
  if (pageTitle.toLowerCase() === 'faq') {
    pageTitle = 'FAQ';
  } else if (pageTitle.toLowerCase() === 'privacy') {
    pageTitle = locale === 'ar' ? 'سياسة الخصوصية' : (locale === 'fr' ? 'Politique de Confidentialité' : 'Privacy Policy');
  } else if (pageTitle.toLowerCase() === 'terms') {
    pageTitle = locale === 'ar' ? 'شروط الخدمة' : (locale === 'fr' ? "Conditions d'Utilisation" : 'Terms of Service');
  } else {
    pageTitle = pageTitle.charAt(0).toUpperCase() + pageTitle.slice(1);
  }

  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": pageTitle,
    "item": Astro.url.href
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};
---

<!DOCTYPE html>
<html dir={dir} lang={locale}>
	<head>
		<meta charset="utf-8" />
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-XKVLJ7V279"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-XKVLJ7V279');

			// Astro View Transitions Compatibility
			document.addEventListener('astro:page-load', () => {
				gtag('config', 'G-XKVLJ7V279', {
					page_path: window.location.pathname,
					page_title: document.title
				});
			});
		</script>
		<!-- Natural language meta tag for international indexers -->
		<meta http-equiv="content-language" content={locale} />

		<!-- Extreme SEO Mobile Rich Previews -->
		<meta name="robots" content={robots} />

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Atlas" />
		<link rel="manifest" href="/site.webmanifest" />
		<!-- Theme color coloring mobile browser bar -->
		<meta name="theme-color" content="#ba0013" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="a5eR51L-fXBXHlPqe5TgDE-f9ueH0133Gwxoo8_ve9U" />
		<meta name="description" content={description} />
		
		<!-- OpenGraph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/og-image.png', Astro.url.href).toString()} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:locale" content={locale === 'ar' ? 'ar_DZ' : (locale === 'fr' ? 'fr_FR' : 'en_US')} />
		<meta property="og:site_name" content={locale === 'ar' ? 'أطلس للكهرباء' : (locale === 'fr' ? 'Atlas Électricité' : 'Atlas Electricity')} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={Astro.url.href} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL('/og-image.png', Astro.url.href).toString()} />

		<link rel="canonical" href={Astro.url.href} />
		
		<!-- Multilingual alternate hreflang tags -->
		<link rel="alternate" hreflang="ar" href={arUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="fr" href={frUrl} />
		<link rel="alternate" hreflang="x-default" href={arUrl} />
		
		<title>{title}</title>

		<!-- Local Business Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
		<!-- WebSite Structured Data (Site Name) -->
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		<!-- Organization Structured Data (Knowledge Graph) -->
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		<!-- BreadcrumbList Structured Data (Search Navigation Paths) -->
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<slot name="head" />
	</head>
	<body class="bg-background text-on-background selection:bg-primary-container selection:text-on-primary-container">
		<slot />

		<!-- Intersection Observer Reveal Animations -->
		<script>
			const setupRevealAnimations = () => {
				const reveals = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');
				
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('active');
							observer.unobserve(entry.target); // Trigger only once
						}
					});
				}, {
					root: null,
					rootMargin: '0px 0px -8% 0px', // Trigger when 8% enters the viewport
					threshold: 0.02
				});

				reveals.forEach(el => observer.observe(el));
			};

			// Run on initial load
			setupRevealAnimations();

			// Listen for Astro view transitions page load
			document.addEventListener('astro:page-load', setupRevealAnimations);
		</script>
	</body>
</html>
